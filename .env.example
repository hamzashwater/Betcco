# Public URLs (no production URL is assumed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# Optional: a privacy-reviewed analytics collection endpoint. It stays disabled
# unless a visitor explicitly enables analytics cookies.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# PostgreSQL
POSTGRES_DB=betcco
POSTGRES_USER=betcco
POSTGRES_PASSWORD=change-me
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=betcco;Username=betcco;Password=<YOUR_LOCAL_POSTGRES_PASSWORD>

# Initial administrator: deliberately blank by default
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ENABLE_DEMO_DATA=false

# Application security
AllowedOrigins__0=http://localhost:3000
DataProtection__KeysPath=../keys
# Version recorded whenever a user explicitly grants or withdraws optional
# marketing communications. Change only after the corresponding notice has
# been legally reviewed and published.
Privacy__MarketingConsentVersion=marketing-consent-v1

# Local email / storage
Email__Provider=Mailpit
Email__FromAddress=no-reply@example.test
Email__Host=localhost
Email__Port=1025
Email__UseSsl=false
Storage__Provider=LocalPrivate
Storage__LocalRoot=../storage
# Development/Test accepts uploads using a safe test scanner. Production must use ClamAv.
Storage__ScannerProvider=Development
ClamAv__Host=
ClamAv__Port=3310
MINIO_ROOT_USER=betcco-local
MINIO_ROOT_PASSWORD=change-me

# Payments: Fake is permitted only for Development/Test. Its confirmation endpoint
# is owner-scoped and protected by the authenticated browser session plus CSRF;
# it is disabled in production. Configure a provider adapter and its webhook secret
# before accepting real payments.
Payments__Provider=Fake
Payments__Currency=JOD
# PayTabs Jordan Hosted Payment Page test profile. Keep these values in local
# environment configuration only; never commit a real server key.
PayTabs__ProfileId=
PayTabs__ServerKey=
PayTabs__BaseUrl=https://secure-jordan.paytabs.com
PayTabs__Environment=Test
Stripe__SecretKey=
Stripe__WebhookSecret=

# Jordan JoFotara is disabled until legal, tax, business-data, and official UBL
# mapping approval. Keep credentials blank and backend-only.
JoFotara__Enabled=false
JoFotara__Environment=
JoFotara__BaseUrl=https://backend.jofotara.gov.jo
JoFotara__ClientId=
JoFotara__SecretKey=

# Payouts: Fake is permitted only for Development/Test and never transfers money.
# A production bank/e-wallet adapter must be configured before enabling real withdrawals.
Payouts__Provider=Fake
Payouts__BankApiKey=
Payouts__EWalletApiKey=

# Optional server-side academic PDF reports. QuestPDF remains disabled by
# default: enable it only after confirming the appropriate license tier and
# deploying an Arabic-capable font directory readable by the API process.
AssessmentReports__PdfProvider=Disabled
AssessmentReports__QuestPdfLicense=
AssessmentReports__FontDirectory=
AssessmentReports__FontFamily=

# AI stays disabled until a real provider is configured
Ai__Enabled=false
Ai__Provider=
Ai__ApiKey=
Ai__Model=
Ai__BaseUrl=https://api.openai.com/v1/

# Optional school SIS interoperability. This is disabled until a school provides
# a OneRoster 1.2 endpoint and scoped access token; no roster import is automatic.
SchoolIntegration__Provider=
SchoolIntegration__OneRoster__BaseUrl=
SchoolIntegration__OneRoster__AccessToken=
