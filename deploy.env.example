# Copy this file outside the repository and replace every placeholder.
# Never use this example as a real staging or production secret file.

# REQUIRED NON-SECRET
BETCCO_ENVIRONMENT=Staging
BETCCO_IMAGE_TAG=<GIT_COMMIT_SHA>
BETCCO_PUBLIC_APP_URL=https://staging.example.invalid
BETCCO_ALLOWED_HOSTS=staging.example.invalid
BETCCO_DATA_PROTECTION_CERTIFICATE_PATH=/absolute/path/to/betcco-data-protection.pfx
BETCCO_S3_BUCKET=<STAGING_PRIVATE_BUCKET>
BETCCO_S3_ENDPOINT=https://s3.example.invalid
BETCCO_S3_REGION=<REGION>
BETCCO_S3_FORCE_PATH_STYLE=false
BETCCO_CLAMAV_HOST=<PRIVATE_CLAMAV_HOST>
BETCCO_CLAMAV_PORT=3310
BETCCO_SMTP_HOST=<SMTP_HOST>
BETCCO_SMTP_PORT=587
BETCCO_SMTP_FROM_ADDRESS=no-reply@staging.example.invalid
BETCCO_WEB_PORT=3000
BETCCO_SHUTDOWN_TIMEOUT_SECONDS=30

# REQUIRED SECRET
BETCCO_POSTGRES_CONNECTION_STRING=<POSTGRES_CONNECTION_STRING>
BETCCO_DATA_PROTECTION_CERTIFICATE_PASSWORD=<DATA_PROTECTION_CERTIFICATE_PASSWORD>

# REQUIRED SECRET unless the S3 provider credential chain is used. Set both or neither.
BETCCO_S3_ACCESS_KEY=<S3_ACCESS_KEY>
BETCCO_S3_SECRET_KEY=<S3_SECRET_KEY>

# OPTIONAL. Set both or neither when the SMTP service requires authentication.
BETCCO_SMTP_USERNAME=<SMTP_USERNAME>
BETCCO_SMTP_PASSWORD=<SMTP_PASSWORD>
