{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "AllowedOrigins": ["http://localhost:3000"],
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "../storage",
    "CleanupIntervalSeconds": 300,
    "StagingGraceMinutes": 15,
    "S3": {
      "Bucket": "",
      "Endpoint": "",
      "Region": "us-east-1",
      "ForcePathStyle": false,
      "AutoCreateBucket": false,
      "MaxRetries": 3,
      "TimeoutSeconds": 100
    }
  },
  "DataProtection": {
    "Provider": "FileSystem",
    "KeysPath": "../keys"
  },
  "Ai": {
    "Enabled": false
  },
  "JoFotara": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
